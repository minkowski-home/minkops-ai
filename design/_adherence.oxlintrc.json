{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/product/**",
              "ui_kits/console/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Readex Pro|Libre Franklin|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Readex Pro, Libre Franklin, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|status|lastActive|enabled|selected|onToggle|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<AgentRow> doesn't accept that prop. Declared props: name, role, status, lastActive, enabled, selected, onToggle, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:active|idle|disabled|error)$/]",
        "message": "<AgentRow> status must be one of 'active' | 'idle' | 'disabled' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|tool|domain|glyph|status|onClick|style|key|ref|className|style|children)$/]",
        "message": "<AgentTile> doesn't accept that prop. Declared props: name, tool, domain, glyph, status, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentTile'] > JSXAttribute[name.name='glyph'] > Literal[value!=/^(?:designer|social|writer|manager|host|kitchen|support|sales|retail|analyst|email)$/]",
        "message": "<AgentTile> glyph must be one of 'designer' | 'social' | 'writer' | 'manager' | 'host' | 'kitchen' | 'support' | 'sales' | 'retail' | 'analyst' | 'email'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|kind|size|square|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, kind, size, square, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:agent|human)$/]",
        "message": "<Avatar> kind must be one of 'agent' | 'human'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|mono|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, mono, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|approval|escalation|review|error|ok|warn)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'approval' | 'escalation' | 'review' | 'error' | 'ok' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconLeft|iconRight|disabled|fullWidth|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconLeft, iconRight, disabled, fullWidth, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|inverse|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'inverse' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|pad|accentEdge|elevated|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, pad, accentEdge, elevated, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|sunken|inverse|accent)$/]",
        "message": "<Card> tone must be one of 'default' | 'sunken' | 'inverse' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|headline|hint|action|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, headline, hint, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:rule|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: rule, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|htmlFor|hint|error|required|children|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, htmlFor, hint, error, required, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:agent|role|output|label|style|key|ref|className|style|children)$/]",
        "message": "<FlowNode> doesn't accept that prop. Declared props: agent, role, output, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|size|active|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: label, size, active, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|mono|size|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: invalid, mono, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Input> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InterruptCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|priority|status|title|description|agentName|taskTitle|suggestedAction|time|onResolve|onAcknowledge|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<InterruptCard> doesn't accept that prop. Declared props: type, priority, status, title, description, agentName, taskTitle, suggestedAction, time, onResolve, onAcknowledge, onDismiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InterruptCard'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:approval|escalation|review|error)$/]",
        "message": "<InterruptCard> type must be one of 'approval' | 'escalation' | 'review' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InterruptCard'] > JSXAttribute[name.name='priority'] > Literal[value!=/^(?:critical|high|medium|low)$/]",
        "message": "<InterruptCard> priority must be one of 'critical' | 'high' | 'medium' | 'low'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InterruptCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:pending|acknowledged)$/]",
        "message": "<InterruptCard> status must be one of 'pending' | 'acknowledged'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|sender|content|time|style|key|ref|className|style|children)$/]",
        "message": "<MessageBubble> doesn't accept that prop. Declared props: role, sender, content, time, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageBubble'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:human|agent)$/]",
        "message": "<MessageBubble> role must be one of 'human' | 'agent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|meta|selected|multi|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<OptionRow> doesn't accept that prop. Declared props: label, meta, selected, multi, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriorityPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|count|children|style|key|ref|className|style|children)$/]",
        "message": "<PriorityPill> doesn't accept that prop. Declared props: level, count, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriorityPill'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:critical|high|medium|low)$/]",
        "message": "<PriorityPill> level must be one of 'critical' | 'high' | 'medium' | 'low'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressSteps'] > JSXAttribute > JSXIdentifier[name!=/^(?:total|current|style|key|ref|className|style|children)$/]",
        "message": "<ProgressSteps> doesn't accept that prop. Declared props: total, current, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|size|pulse|label|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: status, size, pulse, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:active|idle|disabled|error|ok)$/]",
        "message": "<StatusDot> status must be one of 'active' | 'idle' | 'disabled' | 'error' | 'ok'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|autoGrow|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: invalid, autoGrow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|id|style|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, label, disabled, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TypingIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|style|key|ref|className|style|children)$/]",
        "message": "<TypingIndicator> doesn't accept that prop. Declared props: name, style."
      }
    ]
  },
