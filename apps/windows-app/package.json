{
  "name": "minkops-windows-app",
  "version": "0.11.0",
  "description": "Minkops desktop companion and shared console",
  "author": "Minkops",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.js ../../connectors/desktop/tests/*.test.js ../../scripts/tests/*.test.mjs",
    "test:http": "node tests/http-smoke.mjs",
    "build": "node scripts/build.js",
    "start": "npm run build && electron .",
    "package:win": "npm run build && node scripts/package.js",
    "package:win:candidate": "npm run build && node scripts/package.js --unsigned",
    "package:win:dev": "node scripts/build.js --dev && node scripts/package.js --dev"
  },
  "devDependencies": {
    "@minkops/desktop-connectors": "file:../../connectors/desktop",
    "@minkops/desktop-runtime": "file:../../platform/desktop-runtime",
    "builder-util-runtime": "9.7.0",
    "electron": "42.11.10",
    "electron-builder": "^26.0.12",
    "electron-updater": "6.8.10",
    "esbuild": "^0.28.2",
    "js-yaml": "4.3.2"
  },
  "build": {
    "appId": "com.minkops.desktop",
    "productName": "Minkops",
    "directories": {
      "output": "release",
      "app": "bundle"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "Minkops",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "artifactName": "Minkops-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://minkops.com/downloads/"
      }
    ]
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
