{
  "hosting": [
    {
      "target": "corporate",
      "public": "../apps/corporate-website/frontend/dist",
      "ignore": ["**/.*", "**/node_modules/**"],
      "headers": [{"source": "/api/**", "headers": [{"key": "Cache-Control", "value": "private, no-store"}]}],
      "rewrites": [
        {"source": "/api/interest", "run": {"serviceId": "minkops-interest-api", "region": "us-central1"}},
        {"source": "**", "destination": "/index.html"}
      ]
    },
    {
      "target": "console",
      "public": "../apps/solution-web/dist",
      "ignore": ["**/.*", "**/node_modules/**"],
      "headers": [{"source": "/api/**", "headers": [{"key": "Cache-Control", "value": "private, no-store"}]}],
      "rewrites": [
        {"source": "/api/**", "run": {"serviceId": "minkops-solution-api", "region": "us-central1"}},
        {"source": "**", "destination": "/index.html"}
      ]
    }
  ]
}
