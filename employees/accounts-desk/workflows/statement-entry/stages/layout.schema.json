{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layouts",
    "exceptions"
  ],
  "properties": {
    "layouts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_file_id",
          "sheet",
          "header_row",
          "columns",
          "row_order",
          "rows",
          "evidence"
        ],
        "properties": {
          "source_file_id": {
            "type": "string",
            "minLength": 1
          },
          "sheet": {
            "type": "string"
          },
          "header_row": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "columns": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "amount",
              "balance",
              "reference",
              "narration",
              "account",
              "routing_hint"
            ],
            "properties": {
              "date": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "column",
                  "order"
                ],
                "properties": {
                  "column": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "order": {
                    "enum": [
                      "dmy",
                      "mdy",
                      "ymd",
                      "native"
                    ]
                  }
                }
              },
              "amount": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mode",
                      "debit",
                      "credit"
                    ],
                    "properties": {
                      "mode": {
                        "const": "debit_credit"
                      },
                      "debit": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "credit": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mode",
                      "column",
                      "negative"
                    ],
                    "properties": {
                      "mode": {
                        "const": "signed"
                      },
                      "column": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "negative": {
                        "enum": [
                          "debit",
                          "credit"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mode",
                      "column",
                      "indicator",
                      "debit_values",
                      "credit_values"
                    ],
                    "properties": {
                      "mode": {
                        "const": "indicator"
                      },
                      "column": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "indicator": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "debit_values": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 5,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 20
                        }
                      },
                      "credit_values": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 5,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 20
                        }
                      }
                    }
                  }
                ]
              },
              "balance": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "column"
                    ],
                    "properties": {
                      "column": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      }
                    }
                  }
                ]
              },
              "reference": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "column"
                    ],
                    "properties": {
                      "column": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      }
                    }
                  }
                ]
              },
              "narration": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "columns"
                ],
                "properties": {
                  "columns": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    }
                  }
                }
              },
              "account": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "column"
                    ],
                    "properties": {
                      "column": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      }
                    }
                  }
                ]
              },
              "routing_hint": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "column",
                      "label"
                    ],
                    "properties": {
                      "column": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    }
                  }
                ]
              }
            }
          },
          "row_order": {
            "enum": [
              "oldest_first",
              "newest_first"
            ]
          },
          "rows": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "opening": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "column": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "starts_with": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "repeat_header": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "closing": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "column": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "starts_with": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "repeat_header": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "ignore": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "column": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "starts_with": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "repeat_header": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "ends_at": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "column": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "starts_with": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "repeat_header": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_file_id",
          "sheet",
          "code",
          "detail"
        ],
        "properties": {
          "source_file_id": {
            "type": "string",
            "minLength": 1
          },
          "sheet": {
            "type": "string"
          },
          "code": {
            "enum": [
              "not_a_statement",
              "unreadable"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  }
}
