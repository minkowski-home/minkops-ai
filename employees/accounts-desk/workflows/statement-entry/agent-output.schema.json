              "properties": {
                "role": {
                  "enum": [
                    "counter",
                    "tax",
                    "tds",
                    "charge"
                  ]
                },
                "ledger_guid": {
                  "type": "string",
                  "minLength": 1
                },
                "amount": {
                  "type": "number",
                  "exclusiveMinimum": 0
