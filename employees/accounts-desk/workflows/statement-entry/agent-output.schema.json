            "type": "string",
            "minLength": 1
          },
          "sheet": {
            "type": "string"
          },
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "company_guid": {
            "type": [
              "string",
              "null"
            ]
          },
          "bank_ledger_guid": {
            "type": [
              "string",
              "null"
            ]
          },
          "counter_ledger_guid": {
            "type": [
              "string",
              "null"
            ]
          },
          "voucher_type_guid": {
            "type": [
              "string",
              "null"
            ]
          },
          "cost_centre_guid": {
            "type": [
              "string",
              "null"
            ]
          },
          "cost_category_guid": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "exception": {
