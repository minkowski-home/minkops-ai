                "required": [
                  "code",
                  "detail"
                ],
                "properties": {
                  "code": {
                    "enum": [
                      "company_unresolved",
                      "ledger_unresolved",
                      "classification_uncertain",
                      "branch_unresolved",
                      "unsupported_structure"
                    ]
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1500
                  }
                }
              }
            ]
          },
          "family": {
            "enum": [
              "payment",
              "receipt",
              "contra"
