          "source_file_id",
          "sheet",
          "row",
          "company_guid",
          "bank_ledger_guid",
          "counter_ledger_guid",
          "voucher_type_guid",
          "cost_centre_guid",
          "cost_category_guid",
          "evidence",
          "exception"
        ],
        "properties": {
