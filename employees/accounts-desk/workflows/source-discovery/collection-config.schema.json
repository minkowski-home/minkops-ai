{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "depth",
    "excel_source_ids",
    "tally"
  ],
  "properties": {
    "destination_mode": {
      "type": "string",
      "enum": [
        "excel",
        "tally",
        "both"
      ]
    },
    "depth": {
      "const": "client_context"
    },
    "excel_source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true,
      "maxItems": 10
    },
    "tally": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port",
            "period"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "period": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "format": "date"
                },
                "to": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      ]
    }
  }
}
