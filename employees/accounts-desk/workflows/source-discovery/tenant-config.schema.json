{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "destination_mode": {
      "type": "string",
      "enum": [
        "excel",
        "tally",
        "both"
      ],
      "title": "Source systems",
      "x-option-tools": {
        "excel": [
          "excel"
        ],
        "tally": [
          "tally"
        ],
        "both": [
          "excel",
          "tally"
        ]
      }
    },
    "max_files": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "title": "Default file limit"
    }
  },
  "required": [
    "max_files"
  ],
  "additionalProperties": false
}
