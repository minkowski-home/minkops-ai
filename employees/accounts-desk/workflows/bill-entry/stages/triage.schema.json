{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bills"
  ],
  "properties": {
    "bills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_file_id",
          "company_guid",
          "company_evidence",
          "documents",
          "exception"
        ],
        "properties": {
          "source_file_id": {
            "type": "string",
            "minLength": 1
          },
          "company_guid": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200
          },
          "company_evidence": {
            "type": "string",
            "maxLength": 2000
          },
          "documents": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "number",
                "date",
                "supplier_name",
                "supplier_gstin"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "invoice",
                    "credit_note"
                  ]
                },
                "number": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 100
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "supplier_name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 200
                },
                "supplier_gstin": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 15
                }
              }
            }
          },
          "exception": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "detail"
                ],
                "properties": {
                  "code": {
                    "enum": [
                      "company_unresolved",
                      "not_a_bill",
                      "source_unreadable",
                      "multiple_bills_unclear"
                    ]
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
