{
  "key": "bill-entry",
  "version": "0.4.0",
  "name": "Bill entry",
  "description": "Enter reviewed PDF and image bills into existing Excel workbooks.",
  "owner": "accounts-desk",
  "tenant_config_schema": "tenant-config.schema.json",
  "run_config_schema": "run-config.schema.json",
  "output_schema": "output.schema.json",
  "instructions": "SKILL.md",
  "tenant_defaults": {
    "review_mode": "all_outputs",
    "output_mode": "excel_in_place",
    "input_format": "mixed"
  },
  "run_defaults": {
    "input_format": "mixed",
    "checks": [
      "vendor_match",
      "duplicate",
      "totals",
      "cost_codes"
    ]
  },
  "agent_output_schema": "agent-output.schema.json",
  "execution": {
    "environment": "openai_hosted",
    "model": "gpt-6-luna",
    "python_packages": [
      "openpyxl",
      "pymupdf"
    ],
    "instructions": "execution-instructions.md",
    "resources": [],
    "result_path": "/workspace/outputs/result.json"
  },
  "handler": "accounts.bill",
  "presentation": "accounts-bill",
  "capabilities": [
    "files.snapshot"
  ]
}
