{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "review_mode": {
      "type": "string",
      "enum": [
        "all_outputs",
        "only_exceptions"
      ],
      "title": "Default review mode"
    },
    "discovery_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "file_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "destination_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "input_format": {
      "type": "string",
      "enum": [
        "pdf",
        "image",
        "mixed"
      ],
      "title": "Bill inputs"
    },
    "schema_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "company_mode": {
      "type": "string",
      "enum": [
        "locked",
        "infer"
      ],
      "title": "Company selection"
    },
    "locked_company_guid": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "required": [
    "source_ids",
    "file_ids",
    "catalog_version",
    "destination_id",
    "input_format",
    "review_mode",
    "schema_id",
    "schema_version"
  ],
  "additionalProperties": false
}
