{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "records",
    "exceptions"
  ],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tally_record"
      }
    },
    "exceptions": {
      "$ref": "#/$defs/exceptions"
    },
    "notes": {
      "$ref": "#/$defs/notes"
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_file_id",
          "code",
          "reason"
        ],
        "properties": {
          "source_file_id": {
            "type": "string"
          },
          "code": {
            "$ref": "#/$defs/exception_code"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "supplier_details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gstin",
        "registration_type",
        "state_code",
        "state",
        "place_of_supply",
        "address",
        "pincode",
        "evidence"
      ],
      "properties": {
        "gstin": {
          "type": "string",
          "minLength": 15,
          "maxLength": 15
        },
        "registration_type": {
          "enum": [
            "Regular",
            "Composition"
          ]
        },
        "state_code": {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "place_of_supply": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "address": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          }
        },
        "pincode": {
          "type": "string",
          "pattern": "^[1-9][0-9]{5}$"
        },
        "evidence": {
          "type": "array",
          "minItems": 5,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "page",
              "quote"
            ],
            "properties": {
              "field": {
                "enum": [
                  "gstin",
                  "registration_type",
                  "state",
                  "place_of_supply",
                  "address"
                ]
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      }
    },
    "exception_code": {
      "description": "Only genuine blockers. Successful checks, absent optional values and possible duplicates are notes; the application decides duplicates natively.",
      "enum": [
        "source_unreadable",
        "not_a_bill",
        "multiple_bills_unclear",
        "required_value_missing",
        "source_values_conflict",
        "company_unresolved",
        "supplier_unresolved",
        "supplier_missing",
        "classification_uncertain",
        "unsupported_structure"
      ]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/exception_code"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/exception"
      }
    },
    "notes": {
      "description": "Non-blocking internal observations.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "tally_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file_id",
        "operation",
        "company_guid",
        "company_evidence",
        "document",
        "voucher",
        "evidence",
        "exceptions"
      ],
      "properties": {
        "source_file_id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "append"
          ]
        },
        "company_guid": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "company_evidence": {
          "type": "string",
          "maxLength": 2000
        },
        "document": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "number",
            "date",
            "total",
            "supplier_name",
            "supplier_gstin",
            "origin"
          ],
          "properties": {
            "kind": {
              "enum": [
                "invoice",
                "credit_note"
              ]
            },
            "number": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "total": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "supplier_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "supplier_gstin": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 15
            },
            "origin": {
              "enum": [
                "domestic",
                "foreign"
              ]
            }
          }
        },
        "voucher": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family",
            "voucher_type_guid",
            "party",
            "lines"
          ],
          "properties": {
            "family": {
              "enum": [
                "purchase",
                "journal",
                "debit_note"
              ]
            },
            "voucher_type_guid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "party": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ledger_guid",
                "new_supplier",
                "evidence"
              ],
              "properties": {
                "ledger_guid": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 200
                },
                "new_supplier": {
                  "type": "boolean"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            },
            "lines": {
              "type": "array",
              "minItems": 1,
              "maxItems": 39,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "ledger_guid",
                  "side",
                  "amount",
                  "cost_centre_guid",
                  "cost_category_guid",
                  "tax",
                  "evidence"
                ],
                "properties": {
                  "role": {
                    "enum": [
                      "expense",
                      "tax",
                      "round_off",
                      "freight",
                      "other_charge",
                      "discount",
                      "tds"
                    ]
                  },
                  "ledger_guid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "side": {
                    "enum": [
                      "debit",
                      "credit"
                    ]
                  },
                  "amount": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "cost_centre_guid": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "cost_category_guid": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "tax": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "head",
                          "rate",
                          "taxable"
                        ],
                        "properties": {
                          "head": {
                            "enum": [
                              "cgst",
                              "sgst",
                              "igst",
                              "cess"
                            ]
                          },
                          "rate": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 100
                          },
                          "taxable": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          }
                        }
                      }
                    ]
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "page",
              "quote"
            ],
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^(number|date|total|supplier|line:[0-9]+)$"
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string"
              }
            }
          }
        },
        "exceptions": {
          "$ref": "#/$defs/exceptions"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "supplier_details": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/supplier_details"
            }
          ]
        }
      }
    }
  }
}
