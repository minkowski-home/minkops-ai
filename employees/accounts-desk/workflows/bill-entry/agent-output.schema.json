{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "records",
    "findings"
  ],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_file_id",
          "destination_file_id",
          "sheet",
          "operation",
          "data",
          "evidence",
          "findings"
        ],
        "properties": {
          "source_file_id": {
            "type": "string",
            "minLength": 1
          },
          "destination_file_id": {
            "type": "string",
            "minLength": 1
          },
          "sheet": {
            "type": "string",
            "minLength": 1
          },
          "table": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "operation": {
            "enum": [
              "append"
            ]
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "page",
                "quote"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "company_guid": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "company_evidence": {
            "type": "string",
            "maxLength": 2000
          },
          "tax_allocations": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {"type":"object", "additionalProperties":false,
              "required":["ref","amount","evidence"],
              "properties":{"ref":{"type":"string","minLength":1},
                "amount":{"type":"number","exclusiveMinimum":0},
                "evidence":{"type":"string","minLength":1,"maxLength":2000}}}
          },
          "master_refs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vendor", "purchase_ledger", "tax_ledger"],
            "properties": {
              "vendor": {"$ref": "#/$defs/master_selection"},
              "purchase_ledger": {"$ref": "#/$defs/master_selection"},
              "tax_ledger": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/master_selection"}]}
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_file_id",
          "reason"
        ],
        "properties": {
          "source_file_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "master_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "evidence"],
      "properties": {
        "ref": {"type": ["string", "null"], "minLength": 1},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 2000},
        "new_supplier": {"type": "boolean"}
      }
    }
  }
}
