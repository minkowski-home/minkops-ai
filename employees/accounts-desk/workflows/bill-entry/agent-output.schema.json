{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "records",
    "exceptions"
  ],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_file_id",
          "destination_file_id",
          "sheet",
          "operation",
          "data",
          "evidence",
          "exceptions"
        ],
        "properties": {
          "source_file_id": {
            "type": "string",
            "minLength": 1
          },
          "destination_file_id": {
            "type": "string",
            "minLength": 1
          },
          "sheet": {
            "type": "string",
            "minLength": 1
          },
          "table": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "operation": {
            "enum": [
              "append"
            ]
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "page",
                "quote"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          },
          "exceptions": {"$ref": "#/$defs/exceptions"},
          "notes": {"$ref": "#/$defs/notes"},
          "company_guid": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "company_evidence": {
            "type": "string",
            "maxLength": 2000
          },
          "tax_allocations": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {"type":"object", "additionalProperties":false,
              "required":["ref","amount","evidence"],
              "properties":{"ref":{"type":"string","minLength":1},
                "amount":{"type":"number","exclusiveMinimum":0},
                "evidence":{"type":"string","minLength":1,"maxLength":2000}}}
          },
          "supplier_details": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/supplier_details"}]},
          "master_refs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vendor", "purchase_ledger", "tax_ledger"],
            "properties": {
              "vendor": {"$ref": "#/$defs/master_selection"},
              "purchase_ledger": {"$ref": "#/$defs/master_selection"},
              "tax_ledger": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/master_selection"}]}
            }
          }
        }
      }
    },
    "exceptions": {"$ref": "#/$defs/exceptions"},
    "notes": {"$ref": "#/$defs/notes"},
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_file_id",
          "code",
          "reason"
        ],
        "properties": {
          "source_file_id": {
            "type": "string"
          },
          "code": {"$ref": "#/$defs/exception_code"},
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "supplier_details": {
      "type": "object", "additionalProperties": false,
      "required": ["gstin", "registration_type", "state_code", "state", "place_of_supply", "address", "pincode", "evidence"],
      "properties": {
        "gstin": {"type": "string", "minLength": 15, "maxLength": 15},
        "registration_type": {"enum": ["Regular", "Composition"]},
        "state_code": {"type": "string", "pattern": "^[0-9]{2}$"},
        "state": {"type": "string", "minLength": 1, "maxLength": 100},
        "place_of_supply": {"type": "string", "minLength": 1, "maxLength": 100},
        "address": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 250}},
        "pincode": {"type": "string", "pattern": "^[1-9][0-9]{5}$"},
        "evidence": {"type": "array", "minItems": 5, "maxItems": 12, "items": {
          "type": "object", "additionalProperties": false, "required": ["field", "page", "quote"],
          "properties": {"field": {"enum": ["gstin", "registration_type", "state", "place_of_supply", "address"]},
            "page": {"type": "integer", "minimum": 1}, "quote": {"type": "string", "minLength": 1, "maxLength": 2000}}
        }}
      }
    },
    "exception_code": {
      "description": "Only genuine blockers. Successful checks, absent optional values and possible duplicates are notes; the application decides duplicates natively.",
      "enum": [
        "source_unreadable",
        "not_a_bill",
        "multiple_bills_unclear",
        "required_value_missing",
        "source_values_conflict",
        "company_unresolved",
        "supplier_unresolved",
        "supplier_missing",
        "classification_uncertain",
        "unsupported_structure"
      ]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": {"$ref": "#/$defs/exception_code"},
        "detail": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "exceptions": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/exception"}},
    "notes": {
      "description": "Non-blocking internal observations.",
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "master_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "evidence"],
      "properties": {
        "ref": {"type": ["string", "null"], "minLength": 1},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 2000},
        "new_supplier": {"type": "boolean"}
      }
    }
  }
}
