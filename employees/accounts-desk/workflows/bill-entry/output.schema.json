{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "schema_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_file_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "file_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "observed_text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file_id",
                "page",
                "field",
                "observed_text"
              ],
              "additionalProperties": false
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "info",
                    "review",
                    "error"
                  ]
                },
                "field": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "code",
                "message",
                "severity",
                "field"
              ],
              "additionalProperties": false
            }
          },
          "review_required": {
            "type": "boolean"
          },
          "reconciliation_status": {
            "type": "string",
            "enum": [
              "matched",
              "exceptions",
              "insufficient_evidence"
            ]
          },
          "data": {
            "type": "object",
            "description": "Business fields validated separately against the confirmed schema pinned to this run."
          }
        },
        "required": [
          "source_file_id",
          "evidence",
          "findings",
          "review_required",
          "reconciliation_status",
          "data"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "review",
              "error"
            ]
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "message",
          "severity",
          "field"
        ],
        "additionalProperties": false
      }
    },
    "artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "review_required",
        "draft_ready",
        "failed"
      ]
    }
  },
  "required": [
    "catalog_version",
    "schema_id",
    "schema_version",
    "records",
    "findings",
    "artifact_id",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "review_required",
              "draft_ready"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
