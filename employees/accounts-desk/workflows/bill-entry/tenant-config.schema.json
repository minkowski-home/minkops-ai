{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "review_mode": {
      "type": "string",
      "enum": [
        "all_outputs",
        "only_exceptions"
      ],
      "title": "Default review mode",
      "x-step": "Review and save"
    },
    "output_mode": {
      "type": "string",
      "enum": [
        "excel_in_place",
        "tally_in_place",
        "both_in_place",
        "draft_excel"
      ],
      "title": "Output platform and write mode",
      "x-option-tools": {
        "excel_in_place": [
          "excel"
        ],
        "tally_in_place": [
          "tally"
        ],
        "both_in_place": [
          "excel",
          "tally"
        ],
        "draft_excel": [
          "excel"
        ]
      }
    },
    "input_format": {
      "type": "string",
      "enum": [
        "pdf",
        "image",
        "mixed"
      ],
      "title": "Bill inputs",
      "x-step": "Read bills"
    },
    "company_mode": {
      "type": "string",
      "enum": [
        "locked",
        "infer"
      ],
      "title": "Company selection"
    },
    "locked_company_guid": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "required": [
    "review_mode",
    "output_mode"
  ],
  "additionalProperties": false
}
