{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "review_mode": {
      "type": "string",
      "enum": [
        "all_outputs",
        "only_exceptions"
      ],
      "title": "Default review mode",
      "x-step": "Review and save"
    },
    "company_mode": {
      "type": "string",
      "enum": [
        "locked",
        "infer"
      ],
      "title": "Company selection"
    },
    "locked_company_guid": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "required": [
    "review_mode"
  ],
  "additionalProperties": false
}
